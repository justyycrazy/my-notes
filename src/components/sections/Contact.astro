---
import FadeInSection from '../effects/FadeInSection.astro';
import Seal from '../decorations/Seal.astro';
import BrushIcon from '../decorations/BrushIcon.astro';
import { SOCIAL_LINKS } from '../../consts';
import { isExternalLink } from '../../utils/url';
---

<section class="pt-24 pb-12">
	<FadeInSection>
		<div class="flex flex-col md:flex-row items-center md:items-start gap-8 md:gap-8 justify-center">
			<div class="shrink-0">
				<Seal text="后会有期" size={110} variant="irregular" vertical={true} fontScale={1.2} />
			</div>
			<div class="flex flex-col gap-4 items-center md:items-start">
			{SOCIAL_LINKS.map((link) => (
				<a
					href={link.href}
					class="text-base flex items-center gap-3 link-hover text-ink-light"
					{...isExternalLink(link.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
				>
					<BrushIcon />
					{link.name}
				</a>
			))}
			</div>
		</div>
	</FadeInSection>

	<FadeInSection class="mt-12 text-center">
		<p
			class="text-xs text-ink-light/40"
		>
			笔墨有尽时，心意自长存
		</p>
	</FadeInSection>
</section>
