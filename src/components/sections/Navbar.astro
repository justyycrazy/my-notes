---
import InkDivider from '../decorations/InkDivider.astro';
import { NAVIGATION_LINKS } from '../../consts';
import { getFullURL } from '../../utils/url';
---

	<nav transition:persist="navbar" class="w-full py-6 px-6 md:px-8 border-b border-divider">
    <div class="mx-auto max-w-5xl flex items-center justify-between">
        <!-- Left: site name -->
        <a
            href={import.meta.env.BASE_URL}
            class="site-name text-2xl md:text-3xl tracking-wider"
        >
            荒田半亩
        </a>

        <!-- Right: nav links -->
        <div class="flex items-center gap-0">
            {
                NAVIGATION_LINKS.map((link, index) => (
                    <>
                        <a href={getFullURL('', link.href, '')} class="nav-link text-sm md:text-base font-serif">
                            {link.name}
                        </a>
                        {index < NAVIGATION_LINKS.length - 1 && (
                            <span class="mx-2 md:mx-4">
                                <InkDivider orientation="vertical" height="20" />
                            </span>
                        )}
                    </>
                ))
            }
        </div>
    </div>
</nav>

<style>
    .site-name {
        font-family: var(--font-brush);
        color: var(--color-ink);
        transition: opacity 500ms ease;
    }
    .site-name:hover {
        opacity: 0.8;
    }
    .nav-link {
        color: var(--color-ink-light);
        letter-spacing: 0.05em;
        transition: color 500ms ease;
    }
    .nav-link:hover {
        color: var(--color-cinnabar);
    }
</style>
