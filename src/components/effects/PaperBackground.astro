<div class="paper-bg">
    <svg width="100%" height="100%" class="opacity-35" aria-hidden="true">
        <filter id="paper-texture" x="0" y="0" width="100%" height="100%">
            <feTurbulence
                type="fractalNoise"
                baseFrequency="0.5"
                numOctaves="4"
                result="noise"
            />
            <feDiffuseLighting
                in="noise"
                surfaceScale="1.5"
                result="diffuse"
                style="lighting-color: var(--color-paper);"
            >
                <feDistantLight azimuth="45" elevation="60" />
            </feDiffuseLighting>
            <feComposite in="diffuse" in2="SourceGraphic" operator="in" />
        </filter>
        <rect width="100%" height="100%" filter="url(#paper-texture)" />
    </svg>
</div>

<style>
    .paper-bg {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
    }
</style>
