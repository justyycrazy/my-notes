---
import Seal from '../decorations/Seal.astro';

interface Props {
    title: string;
    author: string;
    date: string;
}

const { title, author, date } = Astro.props;
---
<header class="flex flex-col items-center text-center pt-16 pb-12">
	    <h1
	        class="font-serif font-black text-5xl leading-tight text-ink tracking-[0.05em]"
	    >
        {title}
    </h1>
    <p
        class="mt-6 text-sm tracking-widest text-ink-light/70"
    >
        {author} · {date}
    </p>
    <div class="mt-8">
        <Seal text="始" size={44} variant="casual" fontScale={1.2} />
    </div>
</header>

