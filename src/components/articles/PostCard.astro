---
import FadeInSection from '../effects/FadeInSection.astro';
import { getPostURL } from '../../utils/url';
import { getDateParts } from '../../utils/date';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'published'>;
  resolvedTags?: Array<CollectionEntry<'tags'>>;
  isLast?: boolean;
}

const { post, resolvedTags = [], isLast = false } = Astro.props;

const { year, month, day } = getDateParts(post.data.createTime);
---

<FadeInSection>
  <div class="py-5">
    <article class="group flex gap-4 md:gap-5">
      <!-- Date block -->
      <div
        class="flex flex-col items-center shrink-0 pt-1 w-11"
      >
        <span
          class="font-mono leading-none text-ink-light/65 text-2xs"
        >
          {day} / {month}
        </span>
        <span
          class="font-mono leading-none mt-0.5 text-ink-light/65 text-base"
        >
          {year}
        </span>
      </div>

      <!-- Content -->
      <div class="flex-1 min-w-0">
        <a
          href={getPostURL(post.data.slug)}
          class="block text-lg md:text-xl font-black font-serif leading-tight tracking-[0.02em] text-ink transition-colors duration-500 hover:text-cinnabar"
        >
          {post.data.title}
        </a>
        <div class="mt-1.5 flex gap-1.5 flex-wrap">
          {resolvedTags.map((tag) => (
            <span
              class="text-xs px-1.5 py-0.5 text-cinnabar border border-divider rounded-[1px] font-serif"
            >
              {tag.data.title}
            </span>
          ))}
        </div>
      </div>
    </article>
  </div>
  {!isLast && (
    <div
      class="w-full h-px bg-divider/35"
    />
  )}
</FadeInSection>

