---
import { getCollection } from 'astro:content';
import ListLayout from '../../layouts/ListLayout.astro';
import { getFullURL, getPostURL } from '../../utils/url';
import type { CollectionPage, WithContext } from 'schema-dts';
export async function getStaticPaths() {
  const tags = await getCollection('tags');
  return tags.map((tag) => ({
    params: { id: tag.id },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const published = await getCollection('published');
const tagPosts = published
  .filter((post) => post.data.tags?.some((t) => t.id === tag.id))
  .sort((a, b) => b.data.createTime.getTime() - a.data.createTime.getTime());

const tagUrl = getFullURL('/tags/', tag.id, '.html');
const tagSchema: WithContext<CollectionPage> = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: tag.data.title,
  url: tagUrl,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: tagPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: getPostURL(post.data.slug),
      name: post.data.title,
    })),
  },
};
---

  <ListLayout
  title={tag.data.title}
  count={tagPosts.length}
  posts={tagPosts}
  emptyMessage="此印记尚无片文，盼添雅辞华章"
  canonical={tagUrl}
  jsonLd={tagSchema}
/>
