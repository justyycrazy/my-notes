---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/sections/Navbar.astro';
import Seal from '../../components/decorations/Seal.astro';
import InkDivider from '../../components/decorations/InkDivider.astro';
import FadeInSection from '../../components/effects/FadeInSection.astro';

import { toChineseDigit } from '../../utils/number';
import { getPostURL, getFullURL } from '../../utils/url';
import { getDateParts } from '../../utils/date';
import { loadCategoryIndex, getCategoryId } from '../../utils/category';
import type { BreadcrumbList, WithContext } from 'schema-dts';
const published = await getCollection('published');
const { all: categories } = await loadCategoryIndex();

// 按 order 排序
const sortedCats = categories.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

// 获取根分类
const roots = sortedCats.filter((c) => !c.data.parent);

// 构建页面数据
const categorySections = roots
  .map((root) => {
    // 获取子分类
    const children = sortedCats.filter((c) => {
      const parentId = c.data.parent ? getCategoryId(c.data.parent) : undefined;
      return parentId === root.id;
    });

    // 该分类及子分类的所有文章
    const relatedIds = [root.id, ...children.map((c) => c.id)];
    const posts = published
      .filter((p) => {
        const catId = getCategoryId(p.data.category);
        return relatedIds.includes(catId);
      })
      .sort((a, b) => b.data.createTime.getTime() - a.data.createTime.getTime());

    const displayPosts = posts.slice(0, 6).map((p) => {
      const { year, month, day } = getDateParts(p.data.createTime);
      return {
        date: `${year}-${month}-${day}`,
        title: p.data.title,
        slug: p.data.slug,
      };
    });

    // 拆成左右两栏
    const mid = Math.ceil(displayPosts.length / 2);
    const leftPosts = displayPosts.slice(0, mid);
    const rightPosts = displayPosts.slice(mid);

    return {
      id: root.id,
      name: root.data.title,
      seal: toChineseDigit(root.data.order),
      count: posts.length,
      leftPosts,
      rightPosts,
      hasMore: posts.length > 6,
    };
  })
  // 隐藏没有文章的分类
  .filter((cat) => cat.count > 0);

const breadcrumbSchema: WithContext<BreadcrumbList> = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: getFullURL('/', 'index', '.html'),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '卷宗',
      item: getFullURL('/categories/', 'index', '.html'),
    },
  ],
};
---

  <BaseLayout canonical={getFullURL('/categories/', 'index', '.html')} jsonLd={breadcrumbSchema}>
  <div class="min-h-screen flex flex-col">
    <Navbar />

  <main class="flex-1 mx-auto w-full max-w-5xl px-6 md:px-8 py-16 md:py-24">
    <!-- Header -->
    <header class="text-center mb-6">
      <h1
        class="text-6xl font-black font-serif text-ink tracking-[0.1em]"
      >
        卷宗
      </h1>
      <p
        class="mt-6 text-base md:text-lg font-serif leading-relaxed max-w-lg mx-auto text-ink-light/70"
      >
        万卷诗书，皆是心迹。择一门径，入此林中。
      </p>
    </header>

    <!-- Divider -->
    <div class="flex justify-center mb-8">
      <div class="w-32">
        <InkDivider orientation="horizontal" width="100%" />
      </div>
    </div>

    <!-- Category sections -->
    {
      categorySections.length === 0 ? (
        <FadeInSection>
          <p
            class="text-sm text-center py-12 font-serif text-ink-light/65"
          >
            暂无卷宗
          </p>
        </FadeInSection>
      ) : (
        categorySections.map((cat) => (
          <FadeInSection>
          <section class="py-8 md:py-10">
            <div class="flex flex-col md:flex-row gap-6 md:gap-10">
              {/* Left: seal + title */}
              <div class="md:shrink-0">
                {/* Mobile: horizontal */}
                <div class="md:hidden flex items-center gap-2">
                  <h2
                    class="text-2xl font-bold font-serif text-ink tracking-[0.08em]"
                  >
                    {cat.name}
                  </h2>
                  <Seal text={cat.seal} size={28} variant="square" fontScale={0.75} />
                </div>

                {/* Desktop: vertical */}
                <div
                  class="hidden md:flex flex-col items-center py-5 px-3 border border-dashed border-divider min-w-14 min-h-[140px]"
                >
                  <Seal text={cat.seal} size={24} variant="square" fontScale={0.7} />
                  <h2
                    class="mt-3 text-3xl font-bold font-serif text-ink tracking-[0.2em]"
                    style="writing-mode: vertical-rl; text-orientation: mixed;"
                  >
                    {cat.name}
                  </h2>
                </div>
              </div>

              {/* Right: post list */}
              <div class="flex-1 min-w-0">
                <p
                  class="text-xs font-serif mb-4 text-cinnabar/75"
                >
                  共撰 {cat.count} 篇
                </p>

                {/* Two-column post list with vertical divider */}
                <div class="flex flex-col md:flex-row md:items-start gap-6 md:gap-0">
                  {/* Left column + divider wrapper */}
                  <div class="flex-1 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-6 md:gap-0">
                    {/* Left post column */}
                    <ul class="flex flex-col gap-0 list-none" data-post-left>
                      {cat.leftPosts.map((post) => (
                        <li>
                          <a
                            href={getPostURL(post.slug)}
                            class="group flex items-baseline gap-3 py-3 text-ink transition-colors duration-500 hover:text-cinnabar"
                          >
                            <time
                              class="text-xs font-mono shrink-0 text-ink-light/60"
                              datetime={post.date}
                            >
                              {post.date}
                            </time>
                            <span class="text-base font-serif truncate flex-1 min-w-0">
                              {post.title}
                            </span>
                            <span
                              class="text-xs opacity-0 group-hover:opacity-40 transition-opacity duration-500 shrink-0 ms-auto text-ink-light"
                              aria-hidden="true"
                            >
                              →
                            </span>
                          </a>
                          <div
                            class="w-full h-px bg-divider/25"
                          />
                        </li>
                      ))}
                    </ul>

                    {/* Vertical divider (desktop only) */}
                    <div class="hidden md:flex items-center justify-center px-6" style="contain: size;" data-post-divider>
                      <InkDivider orientation="vertical" height="100%" />
                    </div>
                  </div>

                  {/* Right post column */}
                  <ul class="flex-1 flex flex-col gap-0 list-none">
                    {cat.rightPosts.map((post) => (
                      <li>
                        <a
                          href={getPostURL(post.slug)}
                          class="group flex items-baseline gap-3 py-3 text-ink transition-colors duration-500 hover:text-cinnabar"
                        >
                          <time
                            class="text-xs font-mono shrink-0 text-ink-light/60"
                            datetime={post.date}
                          >
                            {post.date}
                          </time>
                          <span class="text-base font-serif truncate flex-1 min-w-0">
                            {post.title}
                          </span>
                          <span
                            class="text-xs opacity-0 group-hover:opacity-40 transition-opacity duration-500 shrink-0 ms-auto text-ink-light"
                            aria-hidden="true"
                          >
                            →
                          </span>
                        </a>
                        <div
                          class="w-full h-px bg-divider/25"
                        />
                      </li>
                    ))}
                  </ul>
                </div>

                {/* "细览" link */}
                {cat.hasMore && (
                  <div class="mt-4 text-right">
                    <a
                      href={getFullURL('/categories/', cat.id, '.html')}
                      class="text-sm font-serif inline-flex items-center gap-1 text-ink-light/60 transition-colors duration-500 no-underline hover:text-cinnabar hover:opacity-100"
                    >
                      细览 <span class="font-mono">→</span>
                    </a>
                  </div>
                )}
              </div>
            </div>

            {/* Section divider */}
            <div class="mt-8 md:mt-10">
              <InkDivider orientation="horizontal" width="100%" />
            </div>
          </section>
          </FadeInSection>
        ))
      )
    }
  </main>
  </div>
</BaseLayout>

